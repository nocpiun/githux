+//! One continuous shaped reader paragraph. Padding affects measured advances,
+//! wrapping, paint and hit testing, never the source or copied bytes.
+use super::{OnLink, highlight, open_link};
+use crate::{
+    documents::tree::{Inline, Style},
+    theme::ActiveTheme,
+};
+use gpui::{
+    App, AvailableSpace, Bounds, ClipboardItem, Element, ElementId, Entity, FocusHandle,
+    GlobalElementId, InspectorElementId, IntoElement, LayoutId, MouseButton, ParentElement, Pixels,
+    Point, RenderOnce, ShapedLine, SharedString, Styled, Window, div, fill, point, prelude::*, px,
+    size,
+};
+use std::{cell::RefCell, ops::Range, rc::Rc};
+use unicode_segmentation::UnicodeSegmentation;
+const PAD: f32 = 3.5;
+#[derive(Clone)]
+struct Piece {
+    range: Range<usize>,
+    line: ShapedLine,
+    origin: Point<Pixels>,
+    code: bool,
+}
+#[derive(Default)]
+struct Layout {
+    pieces: Vec<Piece>,
+    bounds: Bounds<Pixels>,
+    line_height: Pixels,
+    code_run_fonts: Vec<SharedString>,
+}
+impl Layout {
+    fn glyph_index(&self, position: Point<Pixels>) -> usize {
+        let local = position - self.bounds.origin;
+        let row = (local.y / self.line_height).floor().max(0.0);
+        for p in &self.pieces {
+            if (p.origin.y / self.line_height).floor() != row {
+                continue;
+            }
+            if local.x < p.origin.x + p.line.width() {
+                return p.range.start
+                    + p.line
+                        .index_for_x(local.x - p.origin.x)
+                        .unwrap_or(p.line.len());
+            }
+        }
+        self.index(position)
+    }
+    fn index(&self, position: Point<Pixels>) -> usize {
+        let local = position - self.bounds.origin;
+        let row = (local.y / self.line_height).floor().max(0.0);
+        let candidates: Vec<_> = self
+            .pieces
+            .iter()
+            .filter(|p| (p.origin.y / self.line_height).floor() == row)
+            .collect();
+        for p in &candidates {
+            if local.x < p.origin.x + p.line.width() {
+                return p.range.start + p.line.closest_index_for_x(local.x - p.origin.x);
+            }
+        }
+        candidates.last().map_or_else(
+            || self.pieces.last().map_or(0, |p| p.range.end),
+            |p| p.range.end,
+        )
+    }
+}
+struct Selection {
+    focus: FocusHandle,
+    anchor: usize,
+    head: usize,
+    dragging: bool,
+    pressed_link: Option<String>,
+}
+impl Selection {
+    fn range(&self) -> Range<usize> {
+        self.anchor.min(self.head)..self.anchor.max(self.head)
+    }
+}
+#[derive(IntoElement)]
+pub(super) struct ReaderInline {
+    id: ElementId,
+    inline: Inline,
+    on_link: Option<OnLink>,
+}
+impl ReaderInline {
+    pub fn new(id: ElementId, inline: Inline, on_link: Option<OnLink>) -> Self {
+        Self {
+            id,
+            inline,
+            on_link,
+        }
+    }
+}
+impl RenderOnce for ReaderInline {
+    fn render(self, window: &mut Window, cx: &mut App) -> impl IntoElement {
+        let state = window.use_keyed_state(self.id.clone(), cx, |_, cx| Selection {
+            focus: cx.focus_handle(),
+            anchor: 0,
+            head: 0,
+            dragging: false,
+            pressed_link: None,
+        });
+        let focus = state.read(cx).focus.clone();
+        let layout = Rc::new(RefCell::new(Layout::default()));
+        let (down, moving, up, keys) = (state.clone(), state.clone(), state.clone(), state.clone());
+        let (dl, ml, link_layout) = (layout.clone(), layout.clone(), layout.clone());
+        let text = self.inline.text.clone();
+        let links = self.inline.links.clone();
+        let on_link = self.on_link;
+        div()
+            .id(self.id)
+            .debug_selector(|| "reader-inline-paragraph".into())
+            .track_focus(&focus)
+            .cursor_text()
+            .on_mouse_down(MouseButton::Left, move |e, w, cx| {
+                let at = dl.borrow().index(e.position);
+                let glyph = link_layout.borrow().glyph_index(e.position);
+                down.update(cx, |s, cx| {
+                    w.focus(&s.focus, cx);
+                    if !e.modifiers.shift {
+                        s.anchor = at;
+                    }
+                    s.head = at;
+                    s.dragging = true;
+                    s.pressed_link = links
+                        .iter()
+                        .find(|(r, _)| r.contains(&glyph))
+                        .map(|(_, url)| url.clone());
+                    cx.notify();
+                });
+            })
+            .on_mouse_move(move |e, _, cx| {
+                if moving.read(cx).dragging && e.dragging() {
+                    let at = ml.borrow().index(e.position);
+                    moving.update(cx, |s, cx| {
+                        s.head = at;
+                        cx.notify();
+                    });
+                }
+            })
+            .on_mouse_up(MouseButton::Left, {
+                let u = up.clone();
+                move |_, _, cx| {
+                    u.update(cx, |s, cx| {
+                        s.dragging = false;
+                        cx.notify();
+                    })
+                }
+            })
+            .on_mouse_up_out(MouseButton::Left, move |_, _, cx| {
+                up.update(cx, |s, cx| {
+                    s.dragging = false;
+                    cx.notify();
+                })
+            })
+            .on_click({
+                let state = state.clone();
+                move |_, w, cx| {
+                    let s = state.read(cx);
+                    if s.anchor == s.head {
+                        if let Some(url) = s.pressed_link.clone() {
+                            open_link(&on_link, &url, w, cx);
+                        }
+                    }
+                }
+            })
+            .on_key_down(move |e, _, cx| {
+                if e.keystroke.modifiers.secondary() {
+                    match e.keystroke.key.as_str() {
+                        "c" => {
+                            let r = keys.read(cx).range();
+                            if !r.is_empty() {
+                                cx.write_to_clipboard(ClipboardItem::new_string(
+                                    text[r].to_string(),
+                                ));
+                                cx.stop_propagation();
+                            }
+                        }
+                        "a" => keys.update(cx, |s, cx| {
+                            s.anchor = 0;
+                            s.head = text.len();
+                            cx.notify();
+                        }),
+                        _ => {}
+                    }
+                }
+            })
+            .child(Paragraph {
+                inline: self.inline,
+                layout,
+                selection: state,
+            })
+    }
+}
+struct Paragraph {
+    inline: Inline,
+    layout: Rc<RefCell<Layout>>,
+    selection: Entity<Selection>,
+}
+impl IntoElement for Paragraph {
+    type Element = Self;
+    fn into_element(self) -> Self {
+        self
+    }
+}
+impl Element for Paragraph {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+    fn id(&self) -> Option<ElementId> {
+        None
+    }
+    fn source_location(&self) -> Option<&'static std::panic::Location<'static>> {
+        None
+    }
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, ()) {
+        let style = window.text_style();
+        let font_size = style.font_size.to_pixels(window.rem_size());
+        let line_height = window.line_height().max(font_size + px(4.0));
+        let theme = cx.theme();
+        let text = self.inline.text.trim_end_matches('\n').to_string();
+        let mut edges = vec![0, text.len()];
+        let mut flags = vec![0u8; text.len()];
+        for (r, kind) in &self.inline.styles {
+            if r.end <= text.len() {
+                edges.extend([r.start, r.end]);
+                if *kind == Style::Code {
+                    flags[r.clone()].fill(1);
+                }
+            }
+        }
+        edges.sort_unstable();
+        edges.dedup();
+        // Sweep the covering intervals once. This is O(styles * log styles),
+        // independent of how many boundaries and code spans a paragraph has.
+        let mut events: Vec<_> = self
+            .inline
+            .styles
+            .iter()
+            .filter(|(_, s)| *s != Style::Code)
+            .flat_map(|(r, k)| [(r.start, true, k), (r.end, false, k)])
+            .collect();
+        events.sort_by_key(|(at, enter, _)| (*at, !*enter));
+        let mut runs = Vec::new();
+        let mut active: Vec<&Style> = Vec::new();
+        let mut event = 0;
+        for e in edges.windows(2) {
+            while event < events.len() && events[event].0 <= e[0] {
+                let (at, enter, kind) = events[event];
+                if enter {
+                    active.push(kind)
+                } else {
+                    active.retain(|k| !std::ptr::eq(*k, kind));
+                }
+                event += 1;
+                let _ = at;
+            }
+            let mut rs = style.clone();
+            for kind in &active {
+                rs = rs.highlight(highlight(kind, &theme.colors, theme.underline_thickness()));
+            }
+            let mut run = rs.to_run(e[1] - e[0]);
+            if flags.get(e[0]) == Some(&1) {
+                run.font.family = theme.mono_family.clone();
+            }
+            runs.push(run);
+        }
+        let layout = self.layout.clone();
+        let code_run_fonts = runs
+            .iter()
+            .filter(|r| r.font.family == theme.mono_family)
+            .map(|r| r.font.family.clone())
+            .collect::<Vec<_>>();
+        let id = window.request_measured_layout(
+            gpui::Style::default(),
+            move |known, available, window, _| {
+                let width = known
+                    .width
+                    .or(match available.width {
+                        AvailableSpace::Definite(w) => Some(w),
+                        _ => None,
+                    })
+                    .unwrap_or(px(100000.0))
+                    .max(px(1.0));
+                let shaped = window.text_system().shape_line(
+                    SharedString::from(text.replace('\n', " ")),
+                    font_size,
+                    &runs,
+                    None,
+                );
+                // GPUI x_for_index scans every glyph. Index once, then use O(1)
+                // lookups at grapheme boundaries during wrapping.
+                let mut positions = vec![shaped.width(); text.len() + 1];
+                for run in &shaped.runs {
+                    for glyph in &run.glyphs {
+                        positions[glyph.index] = glyph.position.x;
+                    }
+                }
+                let mut next = shaped.width();
+                for at in (0..text.len()).rev() {
+                    if positions[at] != shaped.width() {
+                        next = positions[at];
+                    } else {
+                        positions[at] = next;
+                    }
+                }
+                let is_code = |at| flags.get(at) == Some(&1);
+                let code_edges = &edges;
+                let chars: Vec<_> = text
+                    .grapheme_indices(true)
+                    .map(|(at, g)| (at, at + g.len(), g))
+                    .collect();
+                let mut rows = Vec::new();
+                let mut start = 0;
+                while start < chars.len() {
+                    let mut end = start;
+                    let mut used = Pixels::ZERO;
+                    let mut candidate = None;
+                    while end < chars.len() {
+                        let (a, b, g) = chars[end];
+                        if g == "\n" {
+                            end += 1;
+                            break;
+                        }
+                        let code = is_code(a);
+                        let edge = if code && (end == start || code_edges.binary_search(&a).is_ok())
+                        {
+                            px(PAD)
+                        } else {
+                            Pixels::ZERO
+                        };
+                        let closing = if code { px(PAD) } else { Pixels::ZERO };
+                        let advance = positions[b] - positions[a];
+                        if used + edge + advance + closing > width && end > start {
+                            if let Some(c) = candidate {
+                                end = c;
+                            }
+                            break;
+                        }
+                        used += edge + advance;
+                        if code && (end + 1 == chars.len() || code_edges.binary_search(&b).is_ok())
+                        {
+                            used += px(PAD);
+                        }
+                        end += 1;
+                        if g.chars().all(char::is_whitespace) || !g.is_ascii() {
+                            candidate = Some(end);
+                        }
+                    }
+                    end = end.max(start + 1);
+                    rows.push(chars[start].0..chars[end - 1].1);
+                    start = end;
+                }
+                let mut pieces = Vec::new();
+                let mut cursor = shaped.cursor();
+                let mut measured_width = Pixels::ZERO;
+                for (row, range) in rows.iter().enumerate() {
+                    let mut at = range.start;
+                    let mut x = Pixels::ZERO;
+                    while at < range.end {
+                        let code = is_code(at);
+                        let end = code_edges
+                            .get(code_edges.partition_point(|edge| *edge <= at))
+                            .copied()
+                            .filter(|edge| *edge < range.end)
+                            .unwrap_or(range.end);
+                        let line = cursor.take_until(end);
+                        if code {
+                            x += px(PAD);
+                        }
+                        let advance = line.width();
+                        pieces.push(Piece {
+                            range: at..end,
+                            line,
+                            origin: point(x, line_height * row),
+                            code,
+                        });
+                        x += advance;
+                        if code {
+                            x += px(PAD);
+                        }
+                        at = end;
+                    }
+                    measured_width = measured_width.max(x);
+                }
+                let height = line_height * rows.len().max(1);
+                *layout.borrow_mut() = Layout {
+                    pieces,
+                    bounds: Bounds::default(),
+                    line_height,
+                    code_run_fonts: code_run_fonts.clone(),
+                };
+                size(
+                    known.width.unwrap_or(measured_width.ceil().min(width)),
+                    height,
+                )
+            },
+        );
+        (id, ())
+    }
+    fn prepaint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        _: &mut (),
+        _: &mut Window,
+        cx: &mut App,
+    ) {
+        self.layout.borrow_mut().bounds = bounds;
+        #[cfg(feature = "test-support")]
+        {
+            let l = self.layout.borrow();
+            let snapshot = ReaderInlineLayout {
+                text: self.inline.text.clone(),
+                bounds,
+                line_height: l.line_height,
+                code_font: cx.theme().mono_family.clone(),
+                code_run_fonts: l.code_run_fonts.clone(),
+                pieces: l
+                    .pieces
+                    .iter()
+                    .map(|p| ReaderInlinePiece {
+                        range: p.range.clone(),
+                        code: p.code,
+                        text_bounds: Bounds::new(
+                            bounds.origin + p.origin,
+                            size(p.line.width(), l.line_height),
+                        ),
+                        box_bounds: Bounds::new(
+                            bounds.origin + p.origin - point(px(PAD), px(-1.0)),
+                            size(p.line.width() + px(PAD * 2.0), l.line_height - px(2.0)),
+                        ),
+                        fonts: p.line.runs.iter().map(|r| r.font_id).collect(),
+                    })
+                    .collect(),
+            };
+            if !cx.has_global::<ReaderInlineLayouts>() {
+                cx.set_global(ReaderInlineLayouts::default());
+            }
+            cx.global_mut::<ReaderInlineLayouts>()
+                .0
+                .insert(snapshot.text.clone(), snapshot);
+        }
+        #[cfg(not(feature = "test-support"))]
+        let _ = cx;
+    }
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        _: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let l = self.layout.borrow();
+        let selected = self.selection.read(cx).range();
+        let (bg, selection_color) = {
+            let theme = cx.theme();
+            (theme.colors.sunken, theme.colors.selection)
+        };
+        let visible = window.content_mask().bounds;
+        for p in &l.pieces {
+            let origin = l.bounds.origin + p.origin;
+            if origin.y + l.line_height < visible.top() || origin.y > visible.bottom() {
+                continue;
+            }
+            if p.code {
+                let bounds = Bounds::new(
+                    origin - point(px(PAD), px(-1.0)),
+                    size(p.line.width() + px(PAD * 2.0), l.line_height - px(2.0)),
+                );
+                window.paint_quad(gpui::quad(
+                    bounds,
+                    px(4.0),
+                    bg,
+                    gpui::Edges::default(),
